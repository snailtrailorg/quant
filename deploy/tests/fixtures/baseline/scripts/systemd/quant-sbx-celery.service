[Unit]
Description=Quant SBX celery 桩（常驻进程，版本收敛断言样本）
After=default.target
# StartLimit* 归 [Unit] 段（systemd 官方位置；[Service] 内仅为兼容别名）
StartLimitIntervalSec=30
StartLimitBurst=2

[Service]
Type=simple
WorkingDirectory=__SBX_ROOT__/shared
EnvironmentFile=__SBX_ROOT__/shared/.env
ExecStart=__SBX_ROOT__/bin/run-current -m src.sbx.worker
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
