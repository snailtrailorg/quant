#!/usr/bin/env bash
# quant-dbro —— 波次实例 DB 真相源只读查询通道（sudoers QUANT_DEPLOY_QUANT，以 quant 跑）
#
# 属主约束（3b bootstrap 落实）: quant:quant 755，部署于 /usr/local/sbin/quant-dbro。
#   quant 属主（非 root）原因: 本体经 (quant) sudoers 以 quant 执行，DB 连接（PG peer
#   免密）封装在 quant 侧——deploy 不可读 shared/.env，这正是本 wrapper 存在的理由
#   （替代 v3.2 的 deploy_task_units_db_cmd 通道：$QUANT_DB_RO 环境变量需 deploy 侧
#   持有连串，与 .env 属 quant 600 deploy 不可读矛盾——连接下沉到 wrapper 才解得开）。
#
# 动作（设计稿 §2 v3.3 / §3 波次真相源采集 + 批 66b D26 hub 期望源）:
#   quant-dbro live    → live_task status='running' 的单元名清单（task 波）
#   quant-dbro feishu  → im_bot_config enabled 且 provider='feishu' 的单元名清单（feishu 波）
#   （0051 后 feishu_config 已并入 im_bot_config——19 号 IM 统一接入，provider 过滤）
#   quant-dbro hub     → trading_account enabled 行（id|provider 两列——批 66b：
#                        hub 波次/期望集 DB 驱动；provider 列供 playbook 侧 MD 网关白名单过滤，
#                        真源=python list_md_gateway_providers（md_gateway.py）——此处不做 provider
#                        过滤的原因：SQL 无从查注册表，过滤在消费方+同步义务钉 release.yml 注释）
#   固定 SQL 内封不收外部 SQL；输出每行一个（psql -tA）；DB 错误非零退出。
#
# TRANSITION-0115:收口=0116（批 83a 拆表 expand）全环境上产后，重装位并删除本文件的两态分支
#   （`select_trading_table` + 标 `# TRANSITION-0115` 的旧态 SQL 行 + 本注记），回到单态
#   `trading_account`。标记者 = 该行 SQL 属**旧态（0115）**分支，闸门
#   `server/tests/test_deploy_blast_radius.py` 据此放行退役表名/域谓词；未标记者一律禁。
#   背景：release preflight（本 wrapper hub）在 alembic 之前跑、阶段 8 postverify（quant-hbcheck）
#   在之后跑——环境 DB 上产前停在 0115（无新表）、上产后为 0116（新旧两表并存）。单态 wrapper
#   **无**装位时序可解：先装查新表 → preflight 撞未建的表拦停；不装 → postverify 读到**已停止
#   写入的旧表**（真源漂移/漏报）。故过渡期双态是唯一无时序约束解（2026-09-30 prod 实查后定论）。
#   0116 由单步 contract 改为 expand（2026-09-30「两步走」裁定）后，「两态并存」不再是迁移半途
#   异常而是**长期正常态**，故选表须**优先 trading_account**（见 select_trading_table 注释）。

# 严参校验:
#   which 白名单 live|feishu|hub；恰一个参数（sudoers `*` 吃空格——多余参数即拒，防夹带）
#
# 环境变量:
#   QUANT_DBRO_SQL_DIR —— 沙箱模式: 指向假 SQL 输出文件目录（<which>.out=stdout 道具；
#                         <which>.err 在位=模拟 DB 错误非零退出）供套件测试。
#                         生产为空（sudoers env_reset 亦会清空）走下方真 psql。
set -euo pipefail

usage() { echo "用法: quant-dbro <which>  which ∈ live|feishu|hub" >&2; exit 2; }

[ $# -eq 1 ] || usage
which_arg=$1

case "$which_arg" in
  live|feishu|hub) ;;
  *) echo "✗ which 不在白名单（须 live|feishu|hub）: $which_arg" >&2; exit 2 ;;
esac

# ---- 交易域选表：过渡期双态（TRANSITION-0115——收口条件见文件头）----
#   真 0115（本版上产前）  : 仅 external_interface → 旧表 + 'trading' = ANY(capabilities) 域谓词
#   0116 expand 后（并存）  : 两表同在 → **优先 trading_account**（新表=真源：新代码只写它；
#                             旧表已停止写入，读它会漏掉新账号=期望集漂移）
#   0122 contract 后        : 仅 trading_account → 新表，无谓词（表本身即交易域）
#   皆缺 = schema 异常 → 响亮拒绝（不猜、不静默选一侧）
#   注：0116 改为 expand 步后，并存态由「迁移半途异常」变为**长期正常态**——故 pair=11 是
#   **选择**而非报错（旧版在此 return 1，会在 expand 态自锁死 preflight，2026-09-30 修正）。
#   to_regclass 取 search_path 相对名（生产缺省含 public）——故可在 scratch schema 里
#   对两态做本机回归，不必有服务器。
# TRANSITION-0115:BEGIN（本域含旧表名——闸门据此放行；收口时连同函数整段删除）
select_trading_table() {
  local pair tbl
  pair=$(psql -U quant -d quant -v ON_ERROR_STOP=1 -tAc \
    "SELECT (to_regclass('external_interface') IS NOT NULL)::int::text ||
            (to_regclass('trading_account')    IS NOT NULL)::int::text")
  case "$pair" in
    11) tbl=trading_account ;;      # expand 并存态：新表即真源
    01) tbl=trading_account ;;      # contract（0122）后
    10) tbl=external_interface ;;   # 真 0115（本版上产前）
    00) echo "✗ 选表：两表皆不在位——schema 异常，人工处置" >&2; return 1 ;;
    *)  echo "✗ 选表：探测输出异常 [$pair]" >&2; return 1 ;;
  esac
  # 可观测性（2026-10-01）：选表行回带原始 pair——此前 01（仅新表）与 11（两表并存）打印同款，
  # 无法从日志分辨是否仍在 expand 态（prod 上产核验时差点误判）。诊断走 stderr（命令替换
  # 捕获不到 stderr，不污染 stdout）；stdout 仍纯表名，调用方直接拼 SQL。
  echo "[quant-dbro] 选表=$tbl（pair=$pair，过渡期双态 TRANSITION-0115）" >&2
  printf '%s\n' "$tbl"
}
# TRANSITION-0115:END

# 沙箱模式: 假 SQL 输出文件（套件负例/回归道具；生产 QUANT_DBRO_SQL_DIR 为空不走此分支）。
#   置于固定 SQL 构造**之前**——沙箱路径一律不触库（hub 的选表探测亦不跑）。
if [ -n "${QUANT_DBRO_SQL_DIR:-}" ]; then
  sbx_dir=$QUANT_DBRO_SQL_DIR
  if [ -f "$sbx_dir/$which_arg.err" ]; then
    echo "✗ 沙箱模拟 DB 错误（$sbx_dir/$which_arg.err 在位）:" >&2
    cat "$sbx_dir/$which_arg.err" >&2
    exit 1
  fi
  [ -f "$sbx_dir/$which_arg.out" ] || { echo "✗ 沙箱假 SQL 输出缺失: $sbx_dir/$which_arg.out" >&2; exit 1; }
  cat "$sbx_dir/$which_arg.out"
  exit 0
fi

# 固定 SQL（单元名拼装与 server/src 实况一致: trading.py quant-live-task@{tid} /
# im_bots.py quant-feishu-bot@{bid}；live_task.status 有索引 ix_live_task_status）
case "$which_arg" in
  live)
    sql="SELECT 'quant-live-task@' || id || '.service' FROM live_task WHERE status = 'running'"
    ;;
  feishu)
    sql="SELECT 'quant-feishu-bot@' || id || '.service' FROM im_bot_config WHERE enabled AND provider = 'feishu'"
    ;;
  hub)
    hub_tbl=$(select_trading_table) || exit 1
    if [ "$hub_tbl" = trading_account ]; then
      sql="SELECT id || '|' || provider FROM trading_account WHERE enabled"
    else
      sql="SELECT id || '|' || provider FROM external_interface WHERE enabled AND 'trading' = ANY(capabilities)"  # TRANSITION-0115
    fi
    ;;
esac

# 真 psql: 以 quant OS 用户走 PG peer 免密（unix socket，无连串无密码——连接封装于此）。
#   -tA 每行一个值无表头；ON_ERROR_STOP 保证 SQL/DB 错误非零退出（psql 缺省对 -c 错误
#   不保证非零）。DB 用户/库名与 server/.env QUANT_DB_URL 同源（quant@quant），
#   3b-2 首跑按服务器实况核对 socket 可达性。
exec psql -U quant -d quant -v ON_ERROR_STOP=1 -tAc "$sql"
