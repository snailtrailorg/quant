#!/usr/bin/env bash
# quant-hbcheck —— hub 心跳健康检查（sudoers QUANT_DEPLOY_QUANT，以 quant 跑）
#
# 属主约束（3b bootstrap 落实）: quant:quant 755（本体以 quant 跑才能读 shared/.env 与
# 执行 shared venv——deploy 无权直跑 venv，七跑实锤 EACCES）。
#
# 批 66b（D26）v2——DB 驱动期望集 + 两代自适应：
#   期望集=交易域 enabled 行（经 psql peer 免密，同 quant-dbro 通道；provider 白名单过滤在
#   调用方 release.yml——此处验全部期望行，未实现 provider 的行由波次清单天然不含，
#   期望集层面不过滤防漏报）。
#
# TRANSITION-0115:收口=0116（批 83a 拆表 expand）全环境上产后，重装位并删除本文件的两态分支
#   （`select_trading_table` + 标 `# TRANSITION-0115` 的旧态 SQL 行 + 本注记），回到单态
#   `trading_account`。标记者 = 该行 SQL 属**旧态（0115）**分支，闸门
#   `server/tests/test_deploy_blast_radius.py` 据此放行退役表名/域谓词；未标记者一律禁。
#   理由同 quant-dbro：本 wrapper 在**阶段 8 postverify** 跑（alembic 之后），而 release
#   preflight（quant-dbro hub）在 alembic 之前。0116 为 expand 步（旧表留存，2026-09-30 两步走
#   裁定）⇒ 上产后是**新旧两表长期并存**态，期望集必须取新表（旧表已停止写入，读它=期望集漂移）。
#   故 pair=11 为**选择 trading_account**而非报错（逐行验证 per-account 心跳键 quant:hb:md-hub:{id}：
#   TTL>0 + 8 字段齐 + hash 内 ts 判龄
#   （≤90s——防旧心跳 90s 残留 TTL 假过）+ 期望集非空断言。
#   两代自适应：期望 per-account 键全缺且裸键 quant:hb:md-hub 在场 → 回落 legacy 单键校验
#   并显式输出「legacy 模式」（解 wrapper 装位件不随 release 版本化的时序悖论——先装新版
#   后切键的发布链不断）。
#   期望集空（全新 bootstrap 零行/维护期全禁用）→ 显式输出后 exit 0（豁免非静默绿）。
#
# 环境变量（env_reset 下仅控制机/本机直跑可设）:
#   QUANT_DEPLOY_ROOT / QUANT_HB_REDIS_URL
set -euo pipefail

ROOT=${QUANT_DEPLOY_ROOT:-/data/websites/snailtrail.cc/quant}
set -a
# shellcheck disable=SC1091
[ -f "$ROOT/shared/.env" ] && . "$ROOT/shared/.env"
set +a
URL=${QUANT_HB_REDIS_URL:-${VALKEY_URL:-redis://127.0.0.1:6379/4}}

# ---- 交易域选表：过渡期双态（TRANSITION-0115——收口条件见文件头；律同 quant-dbro）----
#   真 0115（本版上产前） → 仅旧表：须带 'trading' = ANY(capabilities) 域谓词
#   expand 并存态 / contract 后 → trading_account（新表=真源；并存时优先取它，防期望集漂移）
# TRANSITION-0115:BEGIN（本域含旧表名——闸门据此放行；收口时连同函数整段删除）
select_trading_table() {
  local pair tbl
  pair=$(psql -U quant -d quant -v ON_ERROR_STOP=1 -tAc \
    "SELECT (to_regclass('external_interface') IS NOT NULL)::int::text ||
            (to_regclass('trading_account')    IS NOT NULL)::int::text")
  case "$pair" in
    11) tbl=trading_account ;;      # expand 并存态：新表即真源
    01) tbl=trading_account ;;      # contract（0122）后
    10) tbl=external_interface ;;   # 真 0115（本版上产前）
    00) echo "✗ 选表：两表皆不在位——schema 异常，人工处置" >&2; return 1 ;;
    *)  echo "✗ 选表：探测输出异常 [$pair]" >&2; return 1 ;;
  esac
  # 可观测性（2026-10-01）：选表行回带原始 pair——01（仅新表）与 11（两表并存）打印同款
  # 曾致无法从日志分辨是否仍在 expand 态。诊断走 stderr；stdout 仍纯表名。
  echo "[quant-hbcheck] 选表=$tbl（pair=$pair，过渡期双态 TRANSITION-0115）" >&2
  printf '%s\n' "$tbl"
}
# TRANSITION-0115:END

# 期望集：交易域 enabled 行 id 清单（quant 属主 psql peer 免密，连接封装同 dbro）
TRADING_TBL=$(select_trading_table) || exit 1
if [ "$TRADING_TBL" = trading_account ]; then
  expect_sql="SELECT id FROM trading_account WHERE enabled"
else
  expect_sql="SELECT id FROM external_interface WHERE enabled AND 'trading' = ANY(capabilities)"  # TRANSITION-0115
fi
EXPECT=$(psql -U quant -d quant -v ON_ERROR_STOP=1 -tAc "$expect_sql")

"$ROOT/shared/venv/bin/python" - "$URL" "$EXPECT" <<'PYEOF'
import sys
import time
import redis

url, expect_raw = sys.argv[1], sys.argv[2]
ids = [x.strip() for x in expect_raw.splitlines() if x.strip()]
r = redis.Redis.from_url(url, socket_timeout=3, decode_responses=True)

HB_PREFIX = "quant:hb:md-hub"
NEED = {"pid", "gen", "subs", "ticks", "bars", "sess_ticks", "last_tick_ts", "dropped_pg"}


def check_key(key: str) -> tuple[bool, str]:
    ttl = r.ttl(key)
    if ttl is None or ttl <= 0:
        return False, f"TTL={ttl}（键缺失/过期）"
    fields = set(r.hkeys(key))
    missing = NEED - fields
    if missing:
        return False, f"缺字段 {sorted(missing)}"
    ts = r.hget(key, "ts")
    try:
        age = time.time() - float(ts) if ts else None
    except (TypeError, ValueError):
        age = None
    if age is None or age > 90:   # hash 内 ts 判龄——防旧心跳 90s 残留 TTL 假过
        return False, f"心跳陈旧（ts={ts}）"
    return True, f"TTL={ttl}s gen={r.hget(key, 'gen')} ts_age={age:.0f}s"


if not ids:
    print("⚠ 期望集空（bootstrap 零行/维护期全禁用）——跳过 hub 心跳检查（显式豁免非静默绿）")
    sys.exit(0)

per_account = [f"{HB_PREFIX}:{i}" for i in ids]
exists = {k: (r.ttl(k) is not None and r.ttl(k) > 0) for k in per_account}
if not any(exists.values()):
    # 两代自适应：per-account 全缺且裸键在场 → legacy 模式（66b 键切换前的发布链不断）
    if r.ttl(HB_PREFIX) is not None and r.ttl(HB_PREFIX) > 0:
        ok, detail = check_key(HB_PREFIX)
        if ok:
            print(f"✓ hub 心跳（legacy 模式·裸键——per-account 键未在位，键切换后本形态应消失）: {detail}")
            sys.exit(0)
        print(f"✗ hub 心跳（legacy 模式·裸键）: {detail}", file=sys.stderr)
        sys.exit(1)

failed = []
for i, key in zip(ids, per_account):
    if not exists[key]:
        failed.append(f"  ✗ 行 id={i} 键 {key} 缺失/过期（hub 未起或心跳断）")
        continue
    ok, detail = check_key(key)
    if not ok:
        failed.append(f"  ✗ 行 id={i} {key}: {detail}")
    else:
        print(f"✓ 行 id={i} 心跳: {detail}")
if failed:
    print(f"✗ hub 心跳检查失败（期望 {len(ids)} 行，{len(failed)} 行不健康）:", file=sys.stderr)
    print("\n".join(failed), file=sys.stderr)
    sys.exit(1)
print(f"✓ hub 心跳全过（期望集 {len(ids)} 行，per-account 键齐备且新鲜）")
PYEOF
