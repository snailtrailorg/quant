#!/usr/bin/env bash
# quant-pip-wrapper —— venv 依赖管理通道（sudoers QUANT_DEPLOY_QUANT，以 quant 跑）
#
# 属主约束（3b bootstrap 落实）: root:root 755，部署于 /usr/local/sbin/quant-pip-wrapper。
#   设计稿 §1：shared/venv 服务以 quant 只读执行，pip 由本 wrapper 以 quant 跑。
#
# 子命令（设计稿 §3 阶段 5 / §3 rollback freeze diff）:
#   freeze                —— pip freeze 输出到 stdout（quant 不写 var/；
#                            ansible 会话捕获后落 var/，deploy 写权——设计稿 §3 注）
#   dry-run <release_id>  —— pip install --dry-run --require-hashes -r <staged>/requirements.lock 预检
#                            （解析失败即非零退出——场景 1 坏 requirements 的拦截点；哈希校验防依赖漂移）
#   install <release_id>  —— 真装（调用侧按指纹变化才触发）
#
# 严参校验:
#   子命令白名单 freeze|dry-run|install；release_id 匹配 ^[0-9]{12}-[a-f0-9]{7,}$
#
# 环境变量:
#   QUANT_DEPLOY_ROOT —— 部署根（生产默认 /data/websites/snailtrail.cc/quant）
#   QUANT_PIP_INDEX   —— pip 索引（默认清华镜像，与 server/requirements.txt 头部约定一致）
set -euo pipefail

ROOT=${QUANT_DEPLOY_ROOT:-/data/websites/snailtrail.cc/quant}
INDEX=${QUANT_PIP_INDEX:-https://pypi.tuna.tsinghua.edu.cn/simple}

[ $# -ge 1 ] && [ $# -le 3 ] || { echo "用法: quant-pip-wrapper freeze|upgrade-tools|dry-run <release_id>|install <release_id>|rebuild <python_path> <release_id>" >&2; exit 2; }
sub=$1
# 批 151：rebuild 参数序=<python_path> <release_id>（release_id 在 $3）；其余子命令在 $2
if [ "$sub" = "rebuild" ]; then
  release_id=${3:-}
else
  release_id=${2:-}
fi

PIP="$ROOT/shared/venv/bin/pip"
# 批 151：rebuild 场景 venv 可能已不存在（正是重建动机）——PIP 预检对其豁免，
# 由 rebuild 分支自建后使用
if [ "$sub" != "rebuild" ]; then
  [ -x "$PIP" ] || { echo "✗ shared/venv pip 不存在: $PIP" >&2; exit 1; }
fi

case "$sub" in
  freeze)
    [ $# -eq 1 ] || { echo "✗ freeze 不收参数" >&2; exit 2; }
    exec "$PIP" freeze
    ;;
  upgrade-tools)
    # 批 124：venv 工具链升级（pip/setuptools/wheel）——setuptools 65.5.1（3.11 venv
    # 自带旧版）有 3 条 CVE，升级即修；**不属 lock 闭包**（工具非运行时依赖——
    # 根查：py_mini_racer 的 pkg_resources 用法可降级；passlib 系残留已清）。
    # only-if-needed=已最新时零动作；幂等可恒跑。
    [ $# -eq 1 ] || { echo "✗ upgrade-tools 不收参数" >&2; exit 2; }
    exec "$PIP" install -U --upgrade-strategy only-if-needed pip setuptools wheel
    ;;
  rebuild)
    # 批 151：venv 解释器重建通道（主体在 case 后共享段——依赖 REQ_STAGED 构造）。
    [ $# -eq 3 ] || { echo "✗ rebuild 必须带 <python_path> <release_id>" >&2; exit 2; }
    py=$2
    [[ "$py" =~ ^/usr/bin/python3\.[0-9]+$ ]] || { echo "✗ python_path 非法（须 /usr/bin/python3.N）: $py" >&2; exit 2; }
    [ -x "$py" ] || { echo "✗ 解释器不存在: $py" >&2; exit 1; }
    ;;
  dry-run|install)
    [ $# -eq 2 ] || { echo "✗ $sub 必须带 release_id" >&2; exit 2; }
    ;;
  *)
    echo "✗ 子命令不在白名单: $sub" >&2
    exit 2
    ;;
esac

if [[ ! "$release_id" =~ ^[0-9]{12}-[a-f0-9]{7,}$ ]]; then
  echo "✗ release_id 非法（须匹配 ^[0-9]{12}-[a-f0-9]{7,}\$）: $release_id" >&2
  exit 2
fi

REQ="$ROOT/releases/$release_id/requirements.lock"
[ -f "$REQ" ] || { echo "✗ requirements.lock 不存在: $REQ" >&2; exit 1; }

# 批 125：本地 fork wheel 的 file:// 绝对路径**无条件**重写为 release 树内。
# lock 生成于控制机绝对路径（pip-compile file: 限制）；deps/ 随切片同步到
# releases/<id>/deps/——那是部署的正道位置（venv 重建只依赖 release 树=自包含）。
# 首版 sed 只在服务器跑（控制机路径不存在）——staging=本机同路径存在但 quant
# 无权读=Permission denied 实证：重写必须无条件（正道位置优先于本机偶然存在的路径）。
REQ_STAGED="/tmp/quant-req-$release_id.lock"
sed "s|file://[^ ]*/deps/|file://$ROOT/releases/$release_id/deps/|g" \
  "$REQ" > "$REQ_STAGED" || { echo "✗ lock 路径重写失败" >&2; exit 1; }
[ -f "$ROOT/releases/$release_id/deps/vnpy-4.5.0+nogui-py3-none-any.whl" ] \
  || { echo "✗ deps/ 未随切片同步（检查 deploy_slices）" >&2; exit 1; }

if [ "$sub" = "rebuild" ]; then
  # 批 151：备份→重建→工具链→按 release 树 lock 全量装配（与 install 同链：file://
  # 重写/哈希校验/孤儿清理/dev 段）。失败任一步非零即退——.bak 兜底手动回滚。
  VENV="$ROOT/shared/venv"
  BAK="$VENV.bak-$(date +%Y%m%d%H%M%S)"
  echo "① 备份旧 venv → $BAK"
  mv "$VENV" "$BAK"
  echo "② ${py} 重建 venv"
  "$py" -m venv "$VENV" || { echo "✗ venv 重建失败——回滚: mv $BAK $VENV" >&2; mv "$BAK" "$VENV" 2>/dev/null || true; exit 1; }
  echo "③ 工具链升级"
  "$VENV/bin/pip" install -q -U pip setuptools wheel -i "$INDEX" || { echo "✗ 工具链失败——回滚: rm -rf $VENV && mv $BAK $VENV" >&2; rm -rf "$VENV"; mv "$BAK" "$VENV" 2>/dev/null || true; exit 1; }
  echo "④ 按 release $release_id 全量装配（--require-hashes）"
  if "$VENV/bin/pip" install --require-hashes -i "$INDEX" -r "$REQ_STAGED"; then
    "$VENV/bin/pip" uninstall -y pyside6 pyside6-addons pyside6-essentials shiboken6 pyqtgraph qdarkstyle >/dev/null 2>&1 || true
    DEV="$ROOT/releases/$release_id/requirements-dev.txt"
    if [ -f "$DEV" ]; then
      "$VENV/bin/pip" install -i "$INDEX" -r "$DEV" || echo "⚠ requirements-dev 安装失败（不阻重建）" >&2
    fi
    echo "✓ rebuild 完成: $($VENV/bin/python --version 2>&1)；旧 venv 备份在 $BAK（确认后可删）"
  else
    echo "✗ 装配失败——回滚: rm -rf $VENV && mv $BAK $VENV" >&2
    rm -rf "$VENV"; mv "$BAK" "$VENV" 2>/dev/null || true
    exit 1
  fi
  exit 0
fi

if [ "$sub" = "dry-run" ]; then
  # 预检：解析/哈希校验，不改 venv；解析不了（坏包名/冲突）即非零退出
  exec "$PIP" install --dry-run --require-hashes -i "$INDEX" -r "$REQ_STAGED"
else
  # 真装：生产 lock（--require-hashes）+ requirements-dev（工具链：ruff——
  # 批 120 采集器曾用 pip_audit（批 123 退役）；dev 无 hash 不校验，装失败不阻发布）
  "$PIP" install --require-hashes -i "$INDEX" -r "$REQ_STAGED"
  # 批 125：GUI 孤儿清理（pyside6 出闭包后其伴生包无依赖者——pip 不自动卸，
  # 不清则 grype 仍扫到旧 FFmpeg。幂等：不存在时 -y 跳过）
  "$PIP" uninstall -y pyside6 pyside6-addons pyside6-essentials shiboken6 pyqtgraph qdarkstyle >/dev/null 2>&1 || true
  DEV="$ROOT/releases/$release_id/requirements-dev.txt"
  if [ -f "$DEV" ]; then
    "$PIP" install -i "$INDEX" -r "$DEV" || echo "⚠ requirements-dev 安装失败（工具链缺位，不阻发布——采集器自会标 degraded）" >&2
  fi
fi
