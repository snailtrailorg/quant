# 多市场混合量化交易平台 · 环境变量模板
# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不入库）
# 用 scripts/init-env.sh 交互式生成 .env（推荐，避免手动 sed 出错）

# === 数据库 (PostgreSQL, 生产 md5 密码认证) ===
# 本地 dev: postgresql://quant@127.0.0.1:5432/quant (trust 免密)
# 生产:     postgresql://quant:强密码@127.0.0.1:5432/quant (md5)
QUANT_DB_URL=postgresql://quant@127.0.0.1:5432/quant

# === 缓存/队列 (Redis/Valkey, 与 safebox 共存时严格隔离 db 号) ===
# db 分配: safebox=db0 | quant: VALKEY=db4, CELERY_BROKER=db5, CELERY_RESULT=db6
# 绝不用 db0/db1/db2/db3 (safebox 占用 db0，避免冲突)
VALKEY_URL=redis://127.0.0.1:6379/4
CELERY_BROKER_URL=redis://127.0.0.1:6379/5
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/6

# === 数据源 ===
TUSHARE_TOKEN=             # Tushare Pro token，分钟线需 2000 积分

# === 全量同步起点 (YYYYMMDD, 影响 bar_1D 历史深度 + 磁盘) ===
# 20100101: 全历史 (约 3GB bar_1D) | 20200101: 近6年 (约 0.8GB)
SYNC_START_DATE=20100101

# === AI 模型 (国内, OpenAI 兼容) ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# === 嵌入模型 (独立 worker, bge-m3) ===
# EMBED_MODEL=BAAI/bge-m3   # 盘后批量，不在主 venv

# === 飞书 (11) ===
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=

# === 实盘交易总开关 (风险防控第一级，.env 总闸) ===
# false: 全平台禁止真实下单（生产默认）。true: 允许实盘（还需 Web 分项开关 live_trading_config + 策略 enabled 共同开启，三级 AND）
# 测试环境设 true，生产永久 false。改了要重启服务才生效（防误操作）
ENABLE_LIVE_TRADING=false

# === 交易所/券商 (实盘, 加密先走测试网) ===
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_PASSPHRASE=
# XTP_*  (中泰, 待券商确认后填)

# === 邮件 SMTP ===
# 配置已 DB 化：Web「系统设置→系统配置」页填 smtp_* 五项（密码加密存储），.env 不再参与。
# SMTP_DEV=true 仅本地开发：不真发、打印邮件内容到日志（显式开关，缺省关闭=未配置视为失败）。
# SMTP_DEV=true
BASE_URL=https://quant.snailtrail.cc  # 邮件链接 base（邀请/重置密码，https）

# XTP 测试账户（test_xtp_*.py 从 .env 读，不写死）
XTP_TEST_ACCOUNT=
XTP_TEST_PASSWORD=
XTP_TEST_CLIENT_ID=1
XTP_TEST_QUOTE_HOST=
XTP_TEST_QUOTE_PORT=6002
XTP_TEST_TRADE_HOST=
XTP_TEST_TRADE_PORT=6102
XTP_TEST_KEY=
