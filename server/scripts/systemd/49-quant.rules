// polkit 规则：允许 quant 用户管理 quant-strategy@* 和 quant-feishu-bot@* systemd 实例
// （Web 后端 web-api 跑 quant 用户，通过 systemctl start/stop 控制策略/飞书子进程）
//
// 部署（服务器，一次性）：
//   sudo cp 49-quant.rules /etc/polkit-1/rules.d/
//   sudo systemctl restart polkit
//
// 覆盖待办 #14（策略 polkit）+ #36（飞书 polkit）

polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "quant" &&
        (action.lookup("unit").startsWith("quant-strategy@") ||
         action.lookup("unit").startsWith("quant-feishu-bot@"))) {
        return polkit.Result.YES;
    }
});
