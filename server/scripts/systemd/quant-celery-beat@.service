[Unit]
Description=Quant Platform Celery Beat Scheduler
After=network-online.target valkey.service quant-celery-worker@%i.service
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
ExecStart=__PROJECT_DIR__/venv/bin/celery -A src.scheduler beat --loglevel=info --schedule /tmp/quant-celerybeat-schedule-%i
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
