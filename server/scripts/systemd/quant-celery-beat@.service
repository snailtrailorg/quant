[Unit]
Description=Quant Platform Celery Beat (%i)
After=network-online.target postgresql.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=quant
WorkingDirectory=/data/websites/snailtrail.cc/quant/server
EnvironmentFile=/data/websites/snailtrail.cc/quant/server/.env
Environment=QT_QPA_PLATFORM=offscreen
ExecStart=/data/websites/snailtrail.cc/quant/server/venv/bin/celery -A src.scheduler beat --loglevel=info --schedule /tmp/quant-celerybeat-schedule
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
