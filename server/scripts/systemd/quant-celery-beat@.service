[Unit]
Description=Quant Platform Celery Beat (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quant
WorkingDirectory=/data/websites/snailtrail.cc/quant/shared
EnvironmentFile=/data/websites/snailtrail.cc/quant/shared/.env
Environment=QT_QPA_PLATFORM=offscreen
ExecStartPre=/usr/bin/mkdir -p /data/websites/snailtrail.cc/quant/shared/runtime
ExecStart=/data/websites/snailtrail.cc/quant/bin/run-current -m celery -A src.scheduler beat --loglevel=info --schedule /data/websites/snailtrail.cc/quant/shared/runtime/celerybeat-schedule
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
