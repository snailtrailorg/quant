[Unit]
Description=Quant Platform Celery Beat Scheduler
After=network-online.target redis.service quant-celery-worker@quant.service
Wants=network-online.target

[Service]
Type=simple
User=quant
Group=quant
WorkingDirectory=/data/websites/snailtrail.org/quant/server
EnvironmentFile=/data/websites/snailtrail.org/quant/server/.env
ExecStart=/data/websites/snailtrail.org/quant/server/venv/bin/celery -A src.scheduler beat --loglevel=info --schedule /tmp/quant-celerybeat-schedule
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
