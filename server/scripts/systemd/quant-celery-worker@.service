[Unit]
Description=Quant Platform Celery Worker
After=network-online.target postgresql.service valkey.service
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
Environment=QT_QPA_PLATFORM=offscreen
ExecStart=__PROJECT_DIR__/venv/bin/celery -A src.scheduler worker -Q celery,risk,data,analysis -c 2 --loglevel=info
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
