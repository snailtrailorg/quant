[Unit]
Description=Quant Platform Celery Worker
After=network-online.target postgresql-18.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=quant
Group=quant
WorkingDirectory=/data/websites/snailtrail.org/quant/server
EnvironmentFile=/data/websites/snailtrail.org/quant/server/.env
ExecStart=/data/websites/snailtrail.org/quant/server/venv/bin/celery -A src.scheduler worker -Q celery,risk,data,analysis -c 2 --loglevel=info
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
