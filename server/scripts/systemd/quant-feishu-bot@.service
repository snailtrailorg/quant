[Unit]
Description=Quant Feishu Bot (Long Connection)
After=network-online.target postgresql.service valkey.service
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
Environment=QT_QPA_PLATFORM=offscreen
ExecStart=__PROJECT_DIR__/venv/bin/python -m src.feishu_bot.ws_client %i
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
