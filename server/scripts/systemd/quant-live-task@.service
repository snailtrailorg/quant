[Unit]
Description=Quant Live Task %i (实盘任务，策略+标的分离)
# 不 Requires 具体 pg/redis 服务名（各机命名不一，写错=永远起不来）；runner 启动探活退避等依赖（SA4）
# SA4：Failed 后由 celery reconciler（sa4_reconciler）按退避自动 reset-failed + start
After=network-online.target quant-md-hub@quant.service
Wants=network-online.target quant-md-hub@quant.service
# 5 次/5 分钟失败后放弃进 Failed → 触发 OnFailure 告警（防无限重启风暴，F-1）
OnFailure=quant-task-failed@%i.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=quant
WorkingDirectory=/data/websites/snailtrail.cc/quant/server
EnvironmentFile=/data/websites/snailtrail.cc/quant/server/.env
Environment=QT_QPA_PLATFORM=offscreen
ExecStart=/data/websites/snailtrail.cc/quant/server/venv/bin/python -m src.strategy_runner.main --task-id %i
# 看门狗：runner 每 10s 喂狗（_sd_notify），挂死 90s 无喂 → systemd 强杀重启（F-3）
WatchdogSec=90
NotifyAccess=main
# 失败终态 → 钩子单元发告警（F-13）
# SA4（2026-08-23）：Restart=always -> on-failure，正常停止 exit(0) 不再拉起（F-36 churn 根修）；
# 退出码 78（EX_CONFIG 永久配置错误）不重启直接 Failed -> OnFailure 告警人工处理
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=30
# 512M 会被 XTP 全市场合约加载尖峰打爆（OOM SIGKILL，2026-08-17 实测）
MemoryMax=1G
CPUQuota=50%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
