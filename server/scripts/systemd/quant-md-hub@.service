[Unit]
Description=Quant MD Hub (共享行情：XTP MD + 分钟聚合 + Valkey Streams 分发)
After=network-online.target
Wants=network-online.target
OnFailure=quant-task-failed@%n.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=quant
WorkingDirectory=/data/websites/snailtrail.cc/quant/shared
EnvironmentFile=/data/websites/snailtrail.cc/quant/shared/.env
Environment=QUANT_LOG_SOURCE=hub
Environment=QT_QPA_PLATFORM=offscreen
Environment=INSTANCE_NAME=%i
ExecStart=/data/websites/snailtrail.cc/quant/bin/run-current -m src.md_hub.main
WatchdogSec=90
NotifyAccess=main
# M5（批60 v15）退出码矩阵：on-failure + Prevent 覆盖
#   Prevent（不重拉）：0=优雅让位（冗余防御）/ 6=boot 闸拦截（被切走者·非现任——切换窗由它独立承接）/
#   78=EX_CONFIG 配置错（B 凭证按 row_id 取数失败 fail-fast，Failed 告警人工）
#   重启码（on-failure 重拉）：
#   1=vnpy缺失·EngineLoop fatal·guarded 污染拒 / 3=真让位（**含正常重启的 30s lease 滞后自愈**——
#   SIGTERM 不 DEL lease，旧 lease TTL 30s 内新进程 NX 失败 exit(3)，30s 后重拉即愈；staging 实证
#   2026-09-22：Prevent 3 会把部署波重启打成永久死，故 3 不进 Prevent）/
#   4=租约重试耗尽 / 5=续租丢（对端接管）
#   重拉不愈则 5 次打穿 StartLimit 进 failed 黑洞=明确失败态非静默
Restart=on-failure
RestartPreventExitStatus=0 6 78
RestartSec=30
# 合约表尖峰同 direct runner（500-700M 预算）；MemoryHigh 先限流后击杀（12 号 §2.5 落地）
MemoryHigh=768M
MemoryMax=1G
CPUQuota=50%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
