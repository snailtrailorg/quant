[Unit]
Description=Quant Platform FastAPI Backend (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quant
WorkingDirectory=/data/websites/snailtrail.cc/quant/server
EnvironmentFile=/data/websites/snailtrail.cc/quant/server/.env
Environment=QT_QPA_PLATFORM=offscreen
ExecStart=/data/websites/snailtrail.cc/quant/server/venv/bin/uvicorn src.web_api.main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
