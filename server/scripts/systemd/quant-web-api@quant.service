[Unit]
Description=Quant Platform FastAPI Backend
After=network-online.target postgresql-18.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=quant
Group=quant
WorkingDirectory=/data/websites/snailtrail.org/quant/server
EnvironmentFile=/data/websites/snailtrail.org/quant/server/.env
ExecStart=/data/websites/snailtrail.org/quant/server/venv/bin/uvicorn src.web_api.main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
